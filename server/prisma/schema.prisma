// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  SENIOR
  ADMIN
}

model User {
  id Int @id
  email String @unique
  name String
  role Role @default(STUDENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  experiences Experience[]
  comments Comment[]
  questions Question[]
  questionUpvotes QuestionUpvote[]
  blogUpvotes ExperienceUpvote[]
  resources Resource[]
  resourceUpvotes ResourceUpvote[]
  application StudentDriveApplication[]
}

enum Status{
  ACCEPTED
  REJECTED
}

model Experience {
  blogId String @id @default(cuid())               // to give id to each blog like thing, like blogid
  userId Int         
  company String                        
  role String                                  // the role which they are assigned in the their respective company
  status Status
  content String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id])          // "user" is the relationship name — use comment.user to access the related User object

  comments Comment[]
  upvotes ExperienceUpvote[]
}

model Comment{
  commentId String @id @default(cuid())
  userId Int
  blogId String 
  content String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  experience Experience @relation(fields: [blogId], references: [blogId])
  user User @relation(fields: [userId], references: [id])
}

model ExperienceUpvote{
  userId Int
  blogId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
  blog Experience @relation(fields: [blogId], references: [blogId])
  @@id([userId, blogId])
}

enum Difficulty{
  EASY
  MODERATE
  HARD
}

model Question{
  questionId String @id @default(cuid())
  userId Int
  company String
  role String                        // for which role of the compamy the question was asked for
  difficulty Difficulty
  topic String
  question String
  round String                   // in which round the question was asked
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  upvotes QuestionUpvote[]
}

model QuestionUpvote{
  userId Int
  questionId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
  question Question @relation(fields: [questionId], references: [questionId])
  @@id([userId, questionId])
}

model Resource{
  resourceId String @id @default(cuid())
  userId Int
  title String
  description String
  URL String
  role String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  upvotes ResourceUpvote[]
}

model ResourceUpvote{
  userId Int
  resourceId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
  resource Resource @relation(fields: [resourceId], references: [resourceId])  
  @@id([userId, resourceId])
}

model PlacementDrive{
  id String @id @default(cuid())
  company String
  offertype String                 // type of hiring, internship or placement
  role String
  dateStart DateTime
  dateEnd DateTime
  criteria Decimal
  stipend Decimal?              // for internship
  package Decimal?             // for placement   
  branch String[]               // branches eligible
  location String             // posting location
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  applications StudentDriveApplication[]
}

enum StatusStudent{
  APPLIED
  SHORTLISTED
  UNDER_PROCESS
  REJECTED
  ACCEPTED
}

model StudentDriveApplication{
  applicationId String @id @default(cuid())
  userId Int
  driveId String
  status StatusStudent
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  drive PlacementDrive @relation(fields: [driveId], references: [id])
  user User @relation(fields: [userId], references: [id])
}