// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  SENIOR
  ADMIN
}

model User {
  id Int @id
  email String @unique
  name String
  role Role @default(STUDENT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  experiences Experience[]
}

enum Status{
  ACCEPTED
  REJECTED
}

model Experience {
  blogId String @id @default(cuid())               // to give id to each blog like thing, like blogid
  userId Int
  name String          // allowing some seniors who dont want to reveal their identity
  company String                        
  role String                                  // the role which they are assigned in the their respective company
  status Status
  content String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id])
}

model Comment{
  commentId String @id @default(cuid())
  
}